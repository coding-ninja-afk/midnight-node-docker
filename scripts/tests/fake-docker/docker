#!/usr/bin/env bash
# Fake `docker` for testing scripts/dbsync-status.sh without a live stack.
# Handles both the compose path (docker compose ... ps/exec -T/logs SERVICE) and the
# Terraform path (docker inspect/exec -i/logs CONTAINER). Every call is appended to
# $FAKE_DIR/calls so tests can assert which stack and network magic were queried.
# Scenario directory $FAKE_DIR holds:
#   db_rows     one "block|slot|epoch|time|lag" line per db-sync reading, consumed in order
#   node_tips   one cardano-cli tip JSON per node reading, consumed in order
#   logs        (optional) db-sync log text
#   down        (optional) service/container suffix to report as not running
set -euo pipefail
: "${FAKE_DIR:?FAKE_DIR not set}"
echo "$*" >> "$FAKE_DIR/calls"

next_line() {  # $1=file: print the next unread line (last line repeats once exhausted)
  local f="$FAKE_DIR/$1" n_file="$FAKE_DIR/.n_$1" n
  n=$(( $(cat "$n_file" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$n_file"
  local total; total=$(wc -l < "$f")
  (( n > total )) && n=$total
  sed -n "${n}p" "$f"
}
is_down() { [[ -f "$FAKE_DIR/down" && "$1" == *"$(cat "$FAKE_DIR/down")" ]]; }

args=" $* "
case "$args" in
  *" ps "*)        svc="${*: -1}"; is_down "$svc" || echo "fake-$svc-id" ;;
  " inspect "*)    is_down "${*: -1}" && echo false || echo true ;;
  *" exec "*"postgres "*)     next_line db_rows ;;
  *" exec "*"cardano-node "*) next_line node_tips ;;
  *" logs "*)      cat "$FAKE_DIR/logs" 2>/dev/null || true ;;
  *) echo "fake docker: unhandled: $*" >&2; exit 99 ;;
esac
